{
  "name": "audit-engagement-tracker",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "seed:profile": "tsx scripts/profile-seed.ts",
    "seed:ingest": "tsx --env-file=.env.local scripts/ingest-seed.ts",
    "auth:create-users": "tsx --env-file=.env.local scripts/create-auth-users.ts",
    "verify:counts": "tsx --env-file=.env.local scripts/verify-counts.ts",
    "verify:rls": "tsx --env-file=.env.local scripts/verify-rls.ts"
  },
  "dependencies": {
    "@supabase/ssr": "^0.7.0",
    "@supabase/supabase-js": "^2.55.0",
    "csv-parse": "^6.1.0",
    "next": "^16.0.0",
    "pg": "^8.16.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/pg": "^8.15.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "^16.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^4.0.0"
  },
  "type": "module"
}
