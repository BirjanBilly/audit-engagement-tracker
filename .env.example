# Browser-safe Supabase settings. The assessment explicitly asks for legacy
# anon/service_role keys, although newer publishable/secret keys also exist.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Never prefix this with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# PostgreSQL session-pooler or direct connection string used only by scripts.
DATABASE_URL=

# Application controls
APP_READ_ONLY=false
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Set before Act 3. Generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
CURSOR_SECRET=

# One-time user creation script inputs. Keep only in .env.local.
REVIEWER_EMAIL=
REVIEWER_PASSWORD=
SECOND_USER_EMAIL=
SECOND_USER_PASSWORD=
